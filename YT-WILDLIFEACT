   "division": "Division 1 — Outfitting and Hunting"
  },
  {
   "id": "ykwildlife-s55",
   "number": "55",
   "text": "An outfitter shall not provide or offer to provide a guide to any person for hunting big game animals except under the authority of an operating certificate and in accordance with the certificate, the outfitting concession, and this Act.",
   "part": "Part 2 — Outfitting, Guiding, and Trapping",
