   "number": "51",
   "text": "No person who is not a Canadian citizen or permanent resident shall apply for, or obtain, or attempt to obtain, an outfitting concession.",
   "part": "Part 2 — Outfitting, Guiding, and Trapping",
   "heading": "Application by citizen or permanent resident only",
   "instrument": "Wildlife Act (Yukon)",
   "division": "Division 1 — Outfitting and Hunting"
  },
  {
   "id": "ykwildlife-s52",
   "number": "52",
   "text": "The Minister shall not issue an outfitting concession in respect of any part of an area described in a previously issued outfitting concession which is still in effect.",
